    {
      const m = location.hash.match(/pv_token=([^&]+)/);
      if (m) { try { localStorage.setItem(TOKEN_KEY, decodeURIComponent(m[1])); } catch { /* 保存できなくても続ける */ } history.replaceState(null, '', location.pathname + location.search); }
    }
    const token = () => { try { return localStorage.getItem(TOKEN_KEY); } catch { return null; } };
    const api = async (path: string, method = 'GET', body?: unknown) => {
      const t = token();
      const headers: Record<string, string> = t ? { authorization: `Bearer ${t}` } : {};
      if (body !== undefined) headers['content-type'] = 'application/json';
      const r = await fetch(`${origin}${path}`, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
      const data = await r.json().catch(() => ({}));
      return { status: r.status, ok: r.ok, body: data };
    };
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const fmt = (n: number) => Number(n).toLocaleString('en-US');
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const N = 21;
    const mod = (n: number) => ((n % N) + N) % N;

    // ===== 音（すべてここで合成するオリジナル。弦の音はウクレレ・三線っぽく、曲は琉球音階）=====
    let ac: AudioContext | null = null;
    let master: GainNode | null = null;
    let soundOn = true;
    try { soundOn = localStorage.getItem('pv_slot_sound') !== 'off'; } catch { /* 既定は音あり */ }
    function audio() {
      if (!ac) {
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        master = ac.createGain();
        master.gain.value = 0.32;
        master.connect(ac.destination);
      }
      if (ac.state === 'suspended') ac.resume();
      return ac;
    }
    function tone(freq: number, start: number, dur: number, o: { type?: OscillatorType; vol?: number; slide?: number } = {}) {
      if (!soundOn || !audio() || !ac || !master) return;
      const { type = 'square', vol = 0.25, slide = 0 } = o;
      const t0 = ac.currentTime + start;
      const osc = ac.createOscillator();
      const g = ac.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, t0);
      if (slide) osc.frequency.exponentialRampToValueAtTime(Math.max(30, freq * slide), t0 + dur);
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(vol, t0 + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      osc.connect(g).connect(master);
      osc.start(t0);
      osc.stop(t0 + dur + 0.02);
    }
    function noise(start: number, dur: number, o: { vol?: number; freq?: number; q?: number; type?: BiquadFilterType } = {}) {
      if (!soundOn || !audio() || !ac || !master) return;
      const { vol = 0.3, freq = 1200, q = 0.8, type = 'lowpass' } = o;
      const t0 = ac.currentTime + start;
      const len = Math.max(1, Math.floor(ac.sampleRate * dur));
      const buf = ac.createBuffer(1, len, ac.sampleRate);
      const ch = buf.getChannelData(0);
      for (let i = 0; i < len; i++) ch[i] = (Math.random() * 2 - 1) * (1 - i / len);
      const src = ac.createBufferSource();
      src.buffer = buf;
      const f = ac.createBiquadFilter();
      f.type = type; f.frequency.value = freq; f.Q.value = q;
      const g = ac.createGain();
      g.gain.value = vol;
      src.connect(f).connect(g).connect(master);
      src.start(t0);
    }
    const NOTE = (n: number) => 440 * Math.pow(2, (n - 69) / 12);
    /**
     * はじいた弦の音（Karplus-Strong 法で合成する）。ウクレレ・三線っぽい音色。
     * bright を上げるとはじいた瞬間が明るく、decay を上げると長く鳴る
     */
    function pluck(midi: number, start: number, dur: number, o: { vol?: number; bright?: number; decay?: number } = {}) {
      if (!soundOn || !audio() || !ac || !master) return;
      const { vol = 0.22, bright = 0.6, decay = 0.996 } = o;
      const sr = ac.sampleRate;
      const len = Math.max(1, Math.floor(sr * dur));
      const buf = ac.createBuffer(1, len, sr);
      const y = buf.getChannelData(0);
      const p = Math.max(2, Math.round(sr / NOTE(midi)));
      // はじいた瞬間のノイズを少しなめらかにして（bright が低いほど丸い音）、遅延線で回す
      let prev = 0;
      for (let i = 0; i < p && i < len; i++) { const w = Math.random() * 2 - 1; prev = bright * w + (1 - bright) * prev; y[i] = prev; }
      for (let i = p; i < len; i++) y[i] = decay * 0.5 * (y[i - p] + y[i - p - 1 >= 0 ? i - p - 1 : 0]);
      const src = ac.createBufferSource();
      src.buffer = buf;
      const g = ac.createGain();
      const t0 = ac.currentTime + start;
      g.gain.setValueAtTime(vol, t0);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      src.connect(g).connect(master);
      src.start(t0);
    }
    /** ウクレレのストローク（下から上へ順に少しずらしてはじく） */
    function strum(notes: readonly number[], start: number, o: { gap?: number; dur?: number; vol?: number; bright?: number } = {}) {
      const { gap = 0.018, dur = 0.7, vol = 0.14, bright = 0.55 } = o;
      notes.forEach((n, i) => pluck(n, start + i * gap, dur, { vol, bright, decay: 0.995 }));
    }
    // 琉球音階（ド・ミ・ファ・ソ・シ）のコード。ウクレレの開放弦（G C E A）に近い押さえ
    const CH = { C: [67, 60, 64, 72], F: [69, 65, 72, 77], G: [67, 62, 71, 74], Em: [67, 64, 71, 76] } as const;
    const SE = {
      bet(n: number) { for (let i = 0; i < n; i++) { tone(2637, i * 0.07, 0.05, { type: 'triangle', vol: 0.1 }); tone(3520, i * 0.07 + 0.015, 0.04, { type: 'sine', vol: 0.06 }); } },
      lever() { noise(0, 0.04, { vol: 0.45, freq: 1800, type: 'bandpass', q: 3 }); pluck(48, 0, 0.18, { vol: 0.12, bright: 0.3, decay: 0.98 }); },
      // リールが回り始める：ウクレレのポロロン
      start() { strum([67, 72, 76, 79], 0, { gap: 0.03, dur: 0.6, vol: 0.12 }); },
      // ストップ：木を叩いたような軽い音
      stop() { pluck(84, 0, 0.08, { vol: 0.12, bright: 0.9, decay: 0.95 }); noise(0, 0.02, { vol: 0.18, freq: 2600, type: 'bandpass', q: 3 }); },
      coin(i = 0) { pluck(i % 2 ? 95 : 91, 0, 0.09, { vol: 0.08, bright: 0.9, decay: 0.97 }); },
      // 当たり（ハイビスカスが光る）：かき鳴らしと、琉球音階の駆け上がり
      hit() {
        strum(CH.C, 0, { gap: 0.012, dur: 1.2, vol: 0.16, bright: 0.8 });
        [72, 76, 77, 79, 83, 84].forEach((n, i) => pluck(n + 12, 0.08 + i * 0.045, 0.5, { vol: 0.11, bright: 0.85 }));
      },
      // 点滅に合わせた短い音
      blip() { pluck(96, 0, 0.12, { vol: 0.05, bright: 0.9, decay: 0.98 }); },
      // ドキドキランプ：心臓の音（ドクン、ドクン）
      heart() { for (const t of [0, 0.22, 0.7, 0.92]) { tone(62, t, 0.16, { type: 'sine', vol: 0.5, slide: 0.6 }); noise(t, 0.06, { vol: 0.3, freq: 180, q: 1 }); } },
      // しだれ柳：きらきら（高い音を降らせる）
      sparkle() { for (let i = 0; i < 14; i++) pluck([96, 95, 91, 89, 88, 84][i % 6], i * 0.07, 0.4, { vol: 0.06, bright: 0.95 }); },
      // しなのちゃんランプ（1G連）
      kana() { strum(CH.F, 0, { gap: 0.015, dur: 1, vol: 0.14, bright: 0.8 }); [77, 79, 83, 84, 88, 89, 91].forEach((n, i) => pluck(n + 12, 0.1 + i * 0.06, 0.5, { vol: 0.1, bright: 0.85 })); },
      replay() { pluck(84, 0, 0.18, { vol: 0.1, bright: 0.7 }); pluck(88, 0.08, 0.22, { vol: 0.1, bright: 0.7 }); },
      buzz() { tone(110, 0, 0.18, { type: 'sawtooth', vol: 0.12 }); },
      nav() { pluck(91, 0, 0.15, { vol: 0.08, bright: 0.8 }); },
      // 役が揃ったときの音。ベル：鈴のような2音、スイカ：太鼓、チェリー：短いはじき
      bell() { for (const [n, t] of [[88, 0], [95, 0.07], [100, 0.14]] as const) pluck(n, t, 0.5, { vol: 0.09, bright: 0.95, decay: 0.997 }); },
      suika() { tone(95, 0, 0.32, { type: 'sine', vol: 0.45, slide: 0.55 }); noise(0, 0.05, { vol: 0.25, freq: 300, q: 1 }); tone(140, 0.16, 0.22, { type: 'sine', vol: 0.3, slide: 0.6 }); },
      cherry() { pluck(84, 0, 0.25, { vol: 0.1, bright: 0.85 }); pluck(91, 0.06, 0.3, { vol: 0.09, bright: 0.85 }); },
      // フリーズ：低いうなりと、風の音
      freeze() { tone(55, 0, 2.5, { type: 'sawtooth', vol: 0.12 }); noise(0, 2.4, { vol: 0.12, freq: 500, q: 0.6 }); },
      // フラッシュ（確定役）：パシャ
      flash() { noise(0, 0.08, { vol: 0.4, freq: 4000, type: 'bandpass', q: 4 }); pluck(100, 0, 0.2, { vol: 0.06, bright: 1 }); },
    };
    // ボーナス中の BGM（琉球音階のオリジナル。ウクレレのメロディに、低い弦の刻み・カッティング・シェイカー）。[MIDI 番号, 拍]
    const BGM: Record<string, { bpm: number; melody: number[][]; chords: (keyof typeof CH)[] }> = {
      big: {
        bpm: 132,
        melody: [
          [72, .5], [76, .5], [77, .5], [79, 1], [77, .5], [76, .5], [72, .5], [71, 1], [72, 1.5], [0, .5],
          [79, .5], [83, .5], [84, 1], [83, .5], [79, .5], [77, 1], [76, .5], [77, .5], [79, 1.5], [0, .5],
          [84, .5], [83, .5], [79, .5], [77, .5], [76, 1], [77, .5], [79, .5], [76, .5], [72, .5], [71, .5], [72, .5], [76, 1], [72, 1.5], [0, .5],
        ],
        chords: ['C', 'C', 'F', 'G', 'C', 'Em', 'F', 'G', 'C', 'F', 'C', 'G', 'C', 'C'],
      },
      reg: {
        bpm: 120,
        melody: [
          [76, .5], [77, .5], [79, 1], [76, .5], [72, .5], [71, 1], [72, .5], [76, .5], [77, 1.5], [0, .5],
          [79, .5], [77, .5], [76, .5], [72, .5], [71, 1], [67, 1], [72, 1.5], [0, .5],
        ],
        chords: ['C', 'F', 'G', 'C', 'F', 'G', 'C', 'C'],
      },
    };
    let bgmTimer: ReturnType<typeof setTimeout> | null = null;
    function bgmPass(key: string) {
      const { bpm, melody, chords } = BGM[key] ?? BGM.big;
      const beat = 60 / bpm;
      // カチャーシーの跳ねたリズム（8分音符の表を長く、裏を短く）
      const swing = (b: number) => Math.floor(b) + (b % 1 === 0.5 ? 0.58 : b % 1);
      let t = 0;
      for (const [n, b] of melody) { if (n) pluck(n, 0.02 + swing(t) * beat, Math.max(0.25, b * beat * 1.3), { vol: 0.16, bright: 0.75 }); t += b; }
      const beats = melody.reduce((a, [, b]) => a + b, 0);
      for (let i = 0; i < beats; i++) {
        const c = CH[chords[Math.floor(i / 2) % chords.length]];
        const at = 0.02 + i * beat;
        pluck(c[1] - 12, at, beat * 0.9, { vol: 0.14, bright: 0.35, decay: 0.993 });                 // 低い弦
        strum(c, at + 0.58 * beat, { gap: 0.008, dur: beat * 0.35, vol: 0.06, bright: 0.7 });          // 裏のカッティング
        noise(at, 0.035, { vol: 0.06, freq: 7000, type: 'highpass' });                                   // シェイカー
        noise(at + 0.58 * beat, 0.03, { vol: 0.045, freq: 8000, type: 'highpass' });
      }
      return beats * beat;
    }
    function startBgm(kind: string) { stopBgm(); const loop = () => { const sec = bgmPass(kind); bgmTimer = setTimeout(loop, sec * 1000 - 20); }; loop(); }
    function stopBgm() { if (bgmTimer) { clearTimeout(bgmTimer); bgmTimer = null; } }
    /** ボーナスのファンファーレ（琉球音階の駆け上がりをかき鳴らしで締める） */
    function fanfare(kind: 'big' | 'reg') {
      const seq = kind === 'big' ? [60, 64, 65, 67, 71, 72, 76, 77, 79, 83, 84] : [67, 71, 72, 76, 79];
      seq.forEach((n, i) => pluck(n + 12, i * 0.06, 0.45, { vol: 0.13, bright: 0.85 }));
      const end = seq.length * 0.06;
      strum(CH.C, end, { gap: 0.012, dur: 1.4, vol: 0.18, bright: 0.85 });
      if (kind === 'big') strum(CH.C.map((n) => n + 12), end + 0.25, { gap: 0.012, dur: 1.2, vol: 0.12, bright: 0.9 });
      return Math.round(end * 1000) + 700;
    }
    function endJingle() {
      [79, 77, 76, 72].forEach((n, i) => pluck(n + 12, i * 0.1, 0.4, { vol: 0.12, bright: 0.8 }));
      strum(CH.G, 0.42, { vol: 0.12, dur: 0.6 });
      strum(CH.C, 0.75, { vol: 0.16, dur: 1.3 });
    }

    const soundBtn = $('sound');
    const showSound = () => { soundBtn.textContent = soundOn ? '🔊 音あり' : '🔇 音なし'; soundBtn.setAttribute('aria-pressed', String(soundOn)); };
    showSound();
    soundBtn.addEventListener('click', () => {
      soundOn = !soundOn;
      try { localStorage.setItem('pv_slot_sound', soundOn ? 'on' : 'off'); } catch { /* 保存できなくても切り替える */ }
      showSound();
      if (!soundOn) { stopBgm(); if (ac) { ac.close(); ac = null; } } else if (bonus) startBgm(bonus.kind);
    });
    const autoBox = $('auto') as HTMLInputElement;
    try { autoBox.checked = localStorage.getItem('pv_doki_auto') === 'on'; } catch { /* 既定は手で止める */ }
    autoBox.addEventListener('change', () => { try { localStorage.setItem('pv_doki_auto', autoBox.checked ? 'on' : 'off'); } catch { /* 保存できなくても切り替える */ } });

    // ===== リール（pos は上段のコマ番号。回るほど減る）=====
    interface Reel { el: HTMLElement; strip: HTMLElement; pos: number; spinning: boolean; startedAt: number; left: number; target: number | null; done: (() => void) | null }
    const reels: Reel[] = [...document.querySelectorAll<HTMLElement>('.dk-reel')].map((el, r) => {
      const strip = el.querySelector('.dk-strip') as HTMLElement;
      const cells: string[] = [];
      for (let k = 0; k < N * 2 + 3; k++) cells.push(REELS[r][k % N]);
      strip.innerHTML = cells.map((s) => `<div class="dk-cell${s === '7' ? ' seven' : ''}"><svg><use href="#dk-${s}"/></svg></div>`).join('');
      return { el, strip, pos: Math.floor(Math.random() * N), spinning: false, startedAt: 0, left: 0, target: null, done: null };
    });
    const cellPx = () => reels[0].el.clientHeight / 3;
    function drawReel(reel: Reel) { reel.strip.style.transform = `translate3d(0, ${-Math.round(mod(reel.pos) * cellPx())}px, 0)`; }
    reels.forEach(drawReel);
    addEventListener('resize', () => reels.forEach(drawReel));
    let last = performance.now();
    function frame(t: number) {
      const dt = Math.min(0.05, (t - last) / 1000);
      last = t;
      for (const reel of reels) {
        if (!reel.spinning) continue;
        const speed = TIMING.cellsPerSec * Math.max(0, Math.min(1, (t - reel.startedAt) / TIMING.accelMs));
        const step = speed * dt;
        if (reel.target != null && step >= reel.left) {
          reel.pos = reel.target; reel.spinning = false; reel.target = null; drawReel(reel);
          const done = reel.done; reel.done = null; done?.();
          continue;
        }
        reel.pos -= step;
        if (reel.target != null) reel.left -= step;
        drawReel(reel);
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    function spinAll(delayed = false) {
      const t = performance.now();
      reels.forEach((reel, i) => { reel.spinning = true; reel.startedAt = t + (delayed ? i * 450 : 0); reel.target = null; });
    }
    function stopAt(r: number, top: number): Promise<void> {
      const reel = reels[r];
      return new Promise((resolve) => { reel.left = mod(reel.pos - top); reel.target = top; reel.done = () => { SE.stop(); resolve(); }; });
    }

    // ===== ハイビスカス =====
    const hibi = [...document.querySelectorAll<HTMLImageElement>('#hibi img')];
    const top = document.querySelector('.dk-top') as HTMLElement;
    const dlamp = $('dlamp');
    const kana = $('kana');
    let lampToken = 0;
    const ALL = [1, 1, 1, 1, 1], NONE = [0, 0, 0, 0, 0];
    const setHibi = (on: number[]) => hibi.forEach((im, i) => im.classList.toggle('on', !!on[i]));
    function clearLamp() { lampToken++; setHibi(NONE); dlamp.classList.remove('on'); top.classList.remove('off'); hibi.forEach((im) => im.classList.remove('rb')); }
    /** 光り方（GOLD の点灯パターンにならう）。最後は全部点いたまま */
    async function playPattern(p: string) {
      const my = ++lampToken;
      const live = () => my === lampToken;
      const blink = async (on: number[], n: number, a: number, b: number) => { for (let k = 0; k < n && live(); k++) { setHibi(on); SE.blip(); await sleep(a); setHibi(NONE); await sleep(b); } };
      SE.hit();
      switch (p) {
        case 'fast': await blink(ALL, 14, 100, 80); break;
        case 'slow': await blink(ALL, 3, 800, 600); break;
        case 'sync': for (let k = 0; k < 7 && live(); k++) { setHibi([1, 0, 1, 0, 1]); await sleep(240); setHibi([0, 1, 0, 1, 0]); await sleep(240); } break;
        case 'b337': for (const n of [3, 3, 7]) { await blink(ALL, n, 140, 160); await sleep(240); } break;
        case 'right': await blink([0, 0, 0, 1, 1], 8, 240, 180); break;
        case 'panel': for (let k = 0; k < 5 && live(); k++) { setHibi(ALL); await sleep(280); setHibi(NONE); top.classList.add('off'); await sleep(240); top.classList.remove('off'); } break;
        case 'left': await blink([1, 1, 0, 0, 0], 8, 240, 180); break;
        case 'reverse': for (let k = 0; k < 3 && live(); k++) { for (let i = 4; i >= 0 && live(); i--) { setHibi(NONE.map((_, j) => (j >= i ? 1 : 0))); await sleep(100); } await sleep(140); setHibi(NONE); await sleep(120); } break;
        case 'doki': dlamp.classList.add('on'); SE.heart(); await blink(ALL, 5, 400, 280); break;
        case 'shidare': SE.sparkle(); for (let k = 0; k < 18 && live(); k++) { hibi.forEach((im, i) => { im.classList.add('on', 'rb'); im.style.setProperty('--h', `${(k * 40 + i * 72) % 360}deg`); }); await sleep(130); } hibi.forEach((im) => im.classList.remove('rb')); break;
        default: await blink(ALL, 4, 400, 280);
      }
      if (live()) setHibi(ALL);
    }

    // ===== 状態 =====
    type Phase = 'idle' | 'spinning' | 'settling';
    type AtGame = { role: Role; nav: number | null; stock: boolean };
    type Spin = { role: Role; pay: number; lamp: 'pre' | 'post' | null; pattern: string | null; premium: string | null; pending: 'big' | 'reg' | null; canAlign: boolean; since: number };
    let phase: Phase = 'idle';
    let bet = 0;
    let replayNext = false;
    let lastStart = 0;
    let tops: (number | null)[] = [null, null, null];
    let target: Target = 'none';
    let stopsReady = false;
    let stopping: Promise<void>[] = [];
    let game: Spin | null = null;
    let bonus: { kind: 'big' | 'reg'; games: AtGame[]; idx: number; paid: number; misses: number; next: 'big' | 'reg' | null; stocked: boolean } | null = null;
    let atGame: AtGame | null = null;
    let pressed: number[] = [];
    let credit = 0;
    let available: number | null = null;
    let since = 0;
    let chain = 0;
    let machine = 1;
    let pending: 'big' | 'reg' | null = null;
    type Counter = { games: number; diff: number; big: number; reg: number; cbell: number; since: number | null; graph: number[] };
    type MCounter = { machine: number; mine: Counter; all: Counter; allBonuses: { kind: string; msince: number; chain: number; created_at: string }[] };
    const emptyCounter = (s: number | null): Counter => ({ games: 0, diff: 0, big: 0, reg: 0, cbell: 0, since: s, graph: [] });
    let counters: MCounter[] = [...MACHINES].map((m) => ({ machine: m, mine: emptyCounter(null), all: emptyCounter(0), allBonuses: [] }));
    let viewMachine = 1;
    let scope: 'mine' | 'all' = 'mine';
    let bonuses: { kind: string; game: number; since: number; chain: number; machine: number }[] = [];
    type MTot = { machine: number; games: number; big: number; reg: number; cbell: number; players: number };

    function msg(text: string, good = false) { $('msg').textContent = text; $('msg').className = 'dk-msg' + (good ? ' good' : ''); }
    function autoStop() { return autoBox.checked; }
    function pressFx(el: Element, cls = 'pressed') { el.classList.add(cls); setTimeout(() => el.classList.remove(cls), 140); }
    function syncCredit() { if (available != null) credit = Math.floor(available / COIN_PT); }
    function renderLeds() {
      $('credit').textContent = available == null ? '----' : fmt(credit);
      $('credit-pt').textContent = available == null ? '' : `${fmt(available)} pt`;
      $('gameLabel').textContent = bonus ? (bonus.kind === 'big' ? 'BIG' : 'REG') : 'GAME';
      $('gameCount').textContent = bonus ? String(bonus.games.length - bonus.idx) : String(since);
      const bar = $('meter');
      if (bonus) { bar.style.width = `${(bonus.idx / bonus.games.length) * 100}%`; bar.classList.remove('over'); $('meterText').textContent = `${bonus.kind.toUpperCase()} 残り ${bonus.games.length - bonus.idx}G`; }
      else if (pending) { bar.style.width = '100%'; bar.classList.remove('over'); $('meterText').textContent = '7 を狙え！'; }
      else if (chain > 0 && since <= 32) { bar.style.width = `${(since / 32) * 100}%`; bar.classList.remove('over'); $('meterText').textContent = `連チャン ${chain} ／ ボーナス後 ${since}G（32G まで）`; }
      else { bar.style.width = '100%'; bar.classList.add('over'); $('meterText').textContent = chain > 0 ? `ボーナス後 ${since}G（32G を超えました）` : `${since}G`; }
      renderMachine();
    }
    function render() {
      renderLeds();
      const mc = counters[viewMachine - 1];
      const c = scope === 'mine' ? mc.mine : mc.all;
      $('cBig').textContent = String(c.big);
      $('cReg').textContent = String(c.reg);
      $('cGames').textContent = fmt(c.games);
      $('cSince').textContent = scope === 'all' ? String(c.since ?? 0) : viewMachine === machine ? String(since) : '—';
      $('rSum').textContent = c.big + c.reg > 0 ? `1/${(c.games / (c.big + c.reg)).toFixed(1)}` : '—';
      $('rBell').textContent = c.cbell > 0 ? `1/${(c.games / c.cbell).toFixed(1)}` : '—';
      const dEl = $('rDiff');
      dEl.textContent = (c.diff > 0 ? '+' : '') + fmt(c.diff);
      dEl.style.color = c.diff > 0 ? '#fca5a5' : c.diff < 0 ? '#93c5fd' : '';
      drawGraph(c.graph, c.games, c.diff);
      document.querySelectorAll<HTMLElement>('[data-view-machine]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.viewMachine) === viewMachine)));
      document.querySelectorAll<HTMLElement>('[data-scope]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.scope === scope)));
      $('histLabel').textContent = scope === 'mine' ? '自分' : 'みんな';
      const hhmm = (iso: string) => new Date(Date.parse(iso) + 9 * 3600_000).toISOString().slice(11, 16);
      const kindHtml = (k: string) => `<b style="color:${k === 'big' ? '#f87171' : '#7dd3fc'}">${k.toUpperCase()}</b>`;
      const chainHtml = (n: number) => (n > 1 ? `<span class="text-pink-300">🌺${n}連</span>` : '<span></span>');
      const items = scope === 'mine'
        ? bonuses.filter((b) => b.machine === viewMachine).map((b) => `<li>${kindHtml(b.kind)}<span>${b.since}G</span>${chainHtml(b.chain)}<span class="text-slate-500">${b.game}回転目</span></li>`)
        : mc.allBonuses.map((b) => `<li>${kindHtml(b.kind)}<span>${b.msince}G</span>${chainHtml(b.chain)}<span class="text-slate-500">${hhmm(b.created_at)}</span></li>`);
      $('history').innerHTML = items.length ? items.join('') : '<li class="text-slate-500">まだありません</li>';
    }
    function drawGraph(graph: number[], games: number, diff: number) {
      const svg = $('graph');
      const W = 400, H = 200, L = 44, R = 8, T = 10, B = 22;
      const pts = [0, ...graph];
      const xs = pts.map((_, i) => i * GRAPH_EVERY);
      if (games % GRAPH_EVERY !== 0 || graph.length === 0) { pts.push(diff); xs.push(games); }
      const maxAbs = Math.max(100, ...pts.map((v) => Math.abs(v)));
      const step = [100, 200, 250, 500, 1000, 2000, 2500, 5000].find((s) => maxAbs / s <= 4) ?? 10000;
      const topV = Math.ceil(maxAbs / step) * step;
      const maxX = Math.max(100, xs[xs.length - 1]);
      const xStep = [50, 100, 200, 250, 500, 1000].find((s) => maxX / s <= 5) ?? 1000;
      const xMax = Math.ceil(maxX / xStep) * xStep;
      const sx = (x: number) => L + (x / xMax) * (W - L - R);
      const sy = (v: number) => T + ((topV - v) / (2 * topV)) * (H - T - B);
      let g = '';
      for (let v = -topV; v <= topV; v += step) {
        g += `<line x1="${L}" x2="${W - R}" y1="${sy(v)}" y2="${sy(v)}" stroke="${v === 0 ? '#64748b' : '#1e293b'}" stroke-width="${v === 0 ? 1.2 : 1}"/>`;
        g += `<text x="${L - 6}" y="${sy(v) + 3.5}" text-anchor="end" font-size="10" fill="#94a3b8">${v > 0 ? '+' : ''}${v}</text>`;
      }
      for (let x = 0; x <= xMax; x += xStep) g += `<text x="${sx(x)}" y="${H - 6}" text-anchor="middle" font-size="10" fill="#94a3b8">${x}</text>`;
      g += `<polyline points="${pts.map((v, i) => `${sx(xs[i]).toFixed(1)},${sy(v).toFixed(1)}`).join(' ')}" fill="none" stroke="#f472b6" stroke-width="2" stroke-linejoin="round"/>`;
      g += `<circle cx="${sx(xs[xs.length - 1])}" cy="${sy(pts[pts.length - 1])}" r="3.5" fill="#f9a8d4"/>`;
      svg.innerHTML = g;
    }
    function renderDays(days: { day: string; games: number; diff: number; big: number; reg: number }[]) {
      $('days').innerHTML = days.length
        ? days.map((d) => `<tr><td>${Number(d.day.slice(5, 7))}/${Number(d.day.slice(8))}</td><td>${fmt(d.games)}</td><td>${d.big}</td><td>${d.reg}</td><td style="color:${d.diff > 0 ? '#fca5a5' : d.diff < 0 ? '#93c5fd' : ''}">${d.diff > 0 ? '+' : ''}${fmt(d.diff)}</td></tr>`).join('')
        : '<tr><td colspan="5" class="text-slate-500">—</td></tr>';
    }
    function moveBlock(): string | null {
      if (pending) return 'ハイビスカスが光っているあいだは台を移れません。7 を揃えてから移ってください';
      if (bonus) return 'ボーナス中は台を移れません';
      if (phase !== 'idle') return 'リールが止まってから移ってください';
      if (replayNext) return 'リプレイのゲームを回してから移ってください';
      return null;
    }
    function renderMachine() {
      document.querySelectorAll<HTMLButtonElement>('[data-machine]').forEach((b) => {
        b.setAttribute('aria-pressed', String(Number(b.dataset.machine) === machine));
        b.classList.toggle('blocked', !!moveBlock());
      });
    }
    const oneInText = (games: number, n: number) => (n > 0 ? `1/${(games / n).toFixed(1)}` : '—');
    function renderMachines(m: { today: MTot[]; week: MTot[] } | undefined) {
      if (!m) return;
      for (const [span, rows] of [['today', m.today], ['week', m.week]] as const) {
        for (const x of rows) {
          const tr = document.querySelector(`[data-mrow="${span}-${x.machine}"]`);
          if (!tr) continue;
          const set = (k: string, v: string) => { const td = tr.querySelector(`[data-k="${k}"]`); if (td) td.textContent = v; };
          set('games', fmt(x.games)); set('big', String(x.big)); set('reg', String(x.reg));
          set('sum', oneInText(x.games, x.big + x.reg)); set('cbell', oneInText(x.games, x.cbell)); set('players', String(x.players));
        }
      }
    }
    document.querySelectorAll<HTMLButtonElement>('[data-period]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('[data-period]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-period-panel]').forEach((p) => { p.hidden = p.dataset.periodPanel !== b.dataset.period; });
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-view-machine]').forEach((b) => b.addEventListener('click', () => { viewMachine = Number(b.dataset.viewMachine); render(); }));
    document.querySelectorAll<HTMLButtonElement>('[data-scope]').forEach((b) => b.addEventListener('click', () => { scope = b.dataset.scope === 'all' ? 'all' : 'mine'; render(); }));

    function applyState(d: { machine: number; pending: 'big' | 'reg' | null; since: number; chain: number; counters?: MCounter[]; machines?: { today: MTot[]; week: MTot[] }; bonuses?: typeof bonuses; days?: { day: string; games: number; diff: number; big: number; reg: number }[]; available?: number }) {
      machine = d.machine ?? 1; viewMachine = machine;
      pending = d.pending; since = d.since ?? 0; chain = d.chain ?? 0;
      if (Array.isArray(d.counters) && d.counters.length === 6) counters = d.counters;
      if (d.bonuses) bonuses = d.bonuses;
      if (d.days) renderDays(d.days);
      if (d.available != null) available = d.available;
      renderMachines(d.machines);
      clearLamp();
      if (pending) { setHibi(ALL); msg('ハイビスカスが光っています。7 を狙って揃えましょう', true); }
    }
    async function refreshShared() {
      try {
        const r = await api('/api/doki/state');
        if (!r.ok) return;
        renderMachines(r.body.machines);
        if (Array.isArray(r.body.counters)) counters = counters.map((c, i) => ({ ...c, all: r.body.counters[i].all, allBonuses: r.body.counters[i].allBonuses }));
        if (phase === 'idle' && !bonus) render();
      } catch { /* 読めなくても続ける */ }
    }
    setInterval(() => { if (token() && document.visibilityState === 'visible' && phase === 'idle' && !bonus) refreshShared(); }, 30_000);

    async function moveTo(m: number) {
      if (m === machine || !token()) return;
      const why = moveBlock();
      if (why) { SE.buzz(); msg(why); return; }
      if (bet > 0) { credit += bet; bet = 0; renderLeds(); }
      let r;
      try { r = await api('/api/doki/machine', 'POST', { machine: m }); } catch { r = { ok: false, status: 0, body: {} }; }
      if (!r.ok) { msg(r.body.reason === 'pending' ? 'ハイビスカスが光っているあいだは台を移れません' : '台を移れませんでした'); return; }
      applyState(r.body);
      msg(`台${m}に移りました`);
      render();
    }
    document.querySelectorAll<HTMLButtonElement>('[data-machine]').forEach((b) => b.addEventListener('click', () => { audio(); moveTo(Number(b.dataset.machine)); }));

    function setControls(enabled: boolean) { ($('lever') as HTMLButtonElement).disabled = !enabled; ($('maxbet') as HTMLButtonElement).disabled = !enabled; }
    async function loadState() {
      if (!token()) { msg('右上の「Discord でログイン」から入ると遊べます'); setControls(false); render(); return; }
      try {
        const r = await api('/api/doki/state');
        if (r.status === 401) { try { localStorage.removeItem(TOKEN_KEY); } catch { /* 消せなくても続ける */ } msg('ログインが切れました。もう一度ログインしてください'); setControls(false); return; }
        if (!r.ok) { msg('台の様子を読み込めませんでした'); return; }
        applyState(r.body);
        syncCredit();
        render();
      } catch { msg('台の様子を読み込めませんでした'); }
    }
    const REASON: Record<string, string> = {
      insufficient: `使えるポイントが足りません（${BET * COIN_PT}pt）`,
      limit: '今日はここまで（1日の回転数の上限です）',
    };

    function maxBet(auto = false) {
      if (phase !== 'idle' || bet > 0 || !token()) return;
      if (!bonus && !replayNext && available != null && available < BET * COIN_PT) { SE.buzz(); msg(REASON.insufficient); return; }
      audio();
      bet = BET;
      if (!auto) pressFx($('maxbet'));
      if (replayNext) replayNext = false; else { SE.bet(BET); credit -= BET; }
      if (!bonus) $('pay').textContent = '0';
      renderLeds();
    }
    // 押し順ナビの声（「ヒダリ！」「ナカ！」「ミギ！」。Soniox で合成した女の子の声を /doki/voice に置いてある）
    const VOICE_FILES = ['hidari', 'naka', 'migi'];
    let voiceBufs: (AudioBuffer | null)[] | null = null;
    function loadVoices() {
      const c = audio();
      if (voiceBufs || !c) return;
      voiceBufs = [null, null, null];
      VOICE_FILES.forEach((f, i) => {
        fetch(`/doki/voice/${f}.mp3`).then((r) => r.arrayBuffer()).then((b) => c.decodeAudioData(b))
          .then((buf) => { if (voiceBufs) voiceBufs[i] = buf; }).catch(() => { /* 読めなければ合図の音だけ */ });
      });
    }
    let voiceSrc: AudioBufferSourceNode | null = null;
    function callNav(r: number | undefined) {
      if (r == null || !soundOn) return;
      const buf = voiceBufs?.[r];
      if (!buf || !ac || !master) { SE.nav(); return; }
      try { voiceSrc?.stop(); } catch { /* もう止まっている */ }
      const src = ac.createBufferSource();
      const g = ac.createGain();
      g.gain.value = 2.2; // 声は合成音より大きめに
      src.buffer = buf;
      src.connect(g).connect(master);
      src.start();
      voiceSrc = src;
    }
    // 役が揃ったときの演出：揃ったライン（チェリーは左リールのチェリー）の絵柄を光らせて、役ごとの音を鳴らす
    let winTimer: ReturnType<typeof setTimeout> | null = null;
    function clearWin() { if (winTimer) { clearTimeout(winTimer); winTimer = null; } document.querySelectorAll('.dk-cell.win').forEach((c) => c.classList.remove('win', 'win-big')); }
    function winFx(f: number[], role: Role) {
      clearWin();
      const cells: [number, number][] = [];
      if (role === 'cherry' || role === 'kcherry' || role === 'mcherry') {
        for (let row = 0; row < 3; row++) if (REELS[0][(f[0] + row) % REELS[0].length] === 'C') cells.push([0, row]);
      } else if (['bell', 'cbell', 'suika', 'replay'].includes(role)) {
        for (const h of lineHits(f)) LINES[h.line].forEach((row, r) => cells.push([r, row]));
      }
      if (!cells.length) return;
      for (const [r, row] of cells) {
        const el = reels[r].strip.children[f[r] + row] as HTMLElement | undefined;
        el?.classList.add('win');
        if (role === 'cbell' || role === 'kcherry' || role === 'mcherry') el?.classList.add('win-big');
      }
      if (role === 'bell' || role === 'cbell') SE.bell();
      else if (role === 'suika') SE.suika();
      else if (role !== 'replay') SE.cherry();
      winTimer = setTimeout(clearWin, 1700);
    }
    function showNav(order: number[] | null) {
      document.querySelectorAll<HTMLElement>('.dk-stop').forEach((b, r) => {
        const navEl = b.querySelector('.dk-nav') as HTMLElement;
        const k = order ? order.indexOf(r) : -1;
        navEl.textContent = k >= 0 && !pressed.includes(r) ? String(k + 1) : '';
        b.classList.toggle('navnext', !!order && order[pressed.length] === r);
      });
    }

    async function lever() {
      if (phase !== 'idle' || !token()) return;
      if (bet === 0) maxBet(true);
      if (bet === 0) return;
      phase = 'spinning';
      tops = [null, null, null];
      stopping = [];
      stopsReady = false;
      pressed = [];
      game = null;
      atGame = null;
      pressFx($('lever'), 'pulled');
      SE.lever();
      clearWin();
      if (soundOn) loadVoices();
      if (!bonus) msg('');
      const waitUntil = lastStart + TIMING.waitMs;
      let delayed = false;
      if (bonus) {
        atGame = bonus.games[bonus.idx];
        target = atGame.role;
      } else {
        let r;
        try { r = await api('/api/doki/spin', 'POST'); } catch { r = { status: 0, ok: false, body: {} }; }
        if (!r.ok) {
          SE.buzz();
          msg(r.status === 401 ? 'ログインが切れました。もう一度ログインしてください' : REASON[r.body.reason] ?? '回せませんでした。少し待ってからもう一度');
          credit += bet; bet = 0; renderLeds();
          phase = 'idle';
          return;
        }
        game = r.body as Spin;
        available = r.body.available;
        target = game.canAlign && game.pending ? game.pending : game.role;
        delayed = game.premium === 'delay';
        if (game.premium === 'senchika') { setHibi(ALL); await sleep(120); setHibi(NONE); }
        if (game.lamp === 'pre' && game.premium !== 'senchika') void playPattern(game.pattern ?? 'normal');
      }
      const wait = waitUntil - performance.now();
      if (wait > 0) await sleep(wait);
      lastStart = performance.now();
      if (game?.premium === 'freeze') {
        // フリーズ：リールが回らずに筐体が震え、そのあとゆっくり回り始める
        $('cab').classList.add('freeze');
        SE.freeze();
        await sleep(2600);
        $('cab').classList.remove('freeze');
      }
      spinAll(delayed);
      if (game?.premium !== 'silent') SE.start();
      await sleep(TIMING.accelMs + (delayed ? 900 : 0));
      if (game?.premium === 'senchika') void playPattern(game.pattern ?? 'normal');
      stopsReady = true;
      document.querySelectorAll<HTMLButtonElement>('.dk-stop').forEach((b) => { b.disabled = false; });
      if (atGame?.role === 'bell' && atGame.nav != null) { showNav(ORDERS[atGame.nav]); callNav(ORDERS[atGame.nav][0]); }
      if (autoStop()) {
        const order = atGame?.role === 'bell' && atGame.nav != null ? ORDERS[atGame.nav] : [0, 1, 2];
        for (const r of order) { await sleep(r === order[0] ? 150 : 280); stop(r); }
      }
    }

    function stop(r: number) {
      if (!stopsReady || tops[r] != null || phase !== 'spinning') return;
      const btn = document.querySelector(`[data-stop="${r}"]`) as HTMLButtonElement;
      btn.disabled = true;
      pressFx(btn);
      // ナビを外した押し順ベルは、こぼし（1枚）にする
      if (atGame?.role === 'bell' && atGame.nav != null && target === 'bell' && ORDERS[atGame.nav][pressed.length] !== r) target = 'bell_miss';
      pressed.push(r);
      if (atGame?.role === 'bell' && atGame.nav != null) {
        showNav(target === 'bell' ? ORDERS[atGame.nav] : null);
      }
      const press = autoStop() ? aimPress(r, tops, target) : mod(Math.floor(reels[r].pos));
      const { top } = chooseStop(r, press, tops, target);
      tops[r] = top;
      stopping.push(stopAt(r, top));
      if (tops.every((t) => t != null)) {
        stopsReady = false;
        phase = 'settling';
        Promise.all(stopping).then(settle);
      }
    }

    async function countUp(n: number, msEach = 40) {
      const base = Number($('pay').textContent) || 0;
      for (let i = 1; i <= n; i++) { $('pay').textContent = String(base + i); credit += 1; renderLeds(); SE.coin(i); await sleep(msEach); }
    }

    async function settle() {
      bet = 0;
      showNav(null);
      const f = tops as number[];
      if (bonus && atGame) {
        const role: Role = target === 'bell_miss' ? 'bell_miss' : atGame.role;
        if (role === 'bell_miss' && atGame.role === 'bell') bonus.misses++;
        winFx(f, role);
        if (role === 'replay') { SE.replay(); replayNext = true; }
        else if (PAYOUT[role] > 0) { await countUp(PAYOUT[role], 25); bonus.paid += PAYOUT[role]; }
        if (atGame.stock && !bonus.stocked) { bonus.stocked = true; kana.classList.add('on'); SE.kana(); msg('しなのちゃんランプ点灯！ 1G連 確定！', true); }
        bonus.idx++;
        if (bonus.idx >= bonus.games.length) await endBonus();
        phase = 'idle';
        renderLeds();
        return;
      }
      const g = game!;
      if (g.lamp === 'post') {
        if (g.premium === 'flash') { $('cab').classList.add('flash'); for (let i = 0; i < 6; i++) { SE.flash(); await sleep(120); } $('cab').classList.remove('flash'); }
        await sleep(80);
        void playPattern(g.pattern ?? 'normal');
      }
      pending = g.pending;
      since = g.since;
      const mc = counters[machine - 1];
      for (const c of [mc.mine, mc.all]) {
        c.games += 1; c.diff += g.pay - BET;
        if (g.role === 'cbell') c.cbell += 1;
        if (c.since != null) c.since += 1;
        if (c.games % GRAPH_EVERY === 0) c.graph.push(c.diff);
      }
      if (target !== 'big' && target !== 'reg') winFx(f, g.role);
      if (target === 'big' || target === 'reg') {
        if (shows(f, target)) { await startBonus(target); phase = 'idle'; renderLeds(); return; }
        msg('7 を狙いましょう（各リールに 7 は1つずつ）', true);
      } else if (target === 'replay') { SE.replay(); replayNext = true; msg('リプレイ'); }
      else if (g.pay > 0) await countUp(g.pay);
      if (g.lamp) msg(g.premium ? 'プレミア！ ボーナス確定！ 次のゲームで 7 を狙いましょう' : 'ハイビスカスが光りました！ 次のゲームで 7 を狙いましょう', true);
      else if (g.role === 'mcherry') msg('中段チェリー！', true);
      if (!bonus) syncCredit();
      render();
      phase = 'idle';
    }

    async function startBonus(kind: 'big' | 'reg') {
      let r;
      try { r = await api('/api/doki/align', 'POST'); } catch { r = { ok: false, status: 0, body: {} }; }
      if (!r.ok) { msg('ボーナスの記録に失敗しました。ページを読み込み直してください'); return; }
      clearLamp();
      pending = null;
      available = r.body.available;
      const d = r.body;
      chain = d.chain;
      bonuses = [{ kind, game: d.today.games, since: d.since, chain: d.chain, machine }, ...bonuses];
      const mc = counters[machine - 1];
      for (const c of [mc.mine, mc.all]) { c[kind] += 1; }
      mc.all.since = 0;
      mc.allBonuses = [{ kind, msince: d.msince ?? 0, chain: d.chain, created_at: new Date().toISOString() }, ...mc.allBonuses];
      since = 0;
      bonus = { kind, games: d.games, idx: 0, paid: 0, misses: 0, next: d.next, stocked: false };
      kana.classList.remove('on');
      msg((kind === 'big' ? '★ BIG BONUS ★' : '☆ REG BONUS ☆') + (chain > 1 ? `　🌺 ${chain}連！` : '') + '　ナビの順に押してください', true);
      $('pay').textContent = '0';
      renderLeds();
      await sleep(fanfare(kind));
      if (soundOn) startBgm(kind);
    }

    async function endBonus() {
      const b = bonus!;
      stopBgm();
      endJingle();
      if (b.misses > 0) {
        try { const r = await api('/api/doki/miss', 'POST', { n: b.misses }); if (r.ok) available = r.body.available; } catch { /* 戻せなくても続ける */ }
      }
      bonus = null;
      kana.classList.remove('on');
      const mc = counters[machine - 1];
      const net = b.paid - BET * b.games.length;
      for (const c of [mc.mine, mc.all]) c.diff += net;
      syncCredit();
      if (b.next) {
        // 1G連：すぐ次のボーナス
        pending = b.next;
        void playPattern('doki');
        msg(`${b.kind === 'big' ? 'BIG' : 'REG'} 終了（${b.paid}枚）。1G連！ 7 を狙いましょう`, true);
      } else {
        msg(`${b.kind === 'big' ? 'BIG' : 'REG'} 終了！ ${b.paid}枚の払い出し。32G までに当たれば連チャン`, true);
      }
      render();
    }

    $('lever').addEventListener('click', lever);
    $('maxbet').addEventListener('click', () => maxBet());
    document.querySelectorAll<HTMLElement>('.dk-stop').forEach((b) => b.addEventListener('click', () => stop(Number(b.dataset.stop))));
    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.repeat) return;
      if (e.code === 'Space' || e.code === 'Enter') {
        e.preventDefault();
        if (phase === 'spinning' && stopsReady) {
          // ナビがあるときはナビの順、なければ左から
          const order = atGame?.role === 'bell' && atGame.nav != null && target === 'bell' ? ORDERS[atGame.nav] : [0, 1, 2];
          const next = order.find((r) => tops[r] == null);
          if (next != null) stop(next);
        } else lever();
      } else if (e.code === 'KeyB') maxBet();
      else if (['Digit1', 'Digit2', 'Digit3', 'Numpad1', 'Numpad2', 'Numpad3'].includes(e.code)) stop(Number(e.code.slice(-1)) - 1);
      else if (['KeyQ', 'KeyW', 'KeyE'].includes(e.code)) stop(['KeyQ', 'KeyW', 'KeyE'].indexOf(e.code));
    });
    void AT_GAMES;
    loadState();
  </script>
</Layout>
