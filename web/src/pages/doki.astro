---
import Layout from '../layouts/Layout.astro';
import { pokerOrigin } from '../lib/poker.ts';
import UserName from '../components/UserName.astro';
import { NAME_STYLE_COLUMNS, nameStyleJoin, type NameStyleRow } from '../lib/name-style.ts';
import { userPath } from '../lib/houses.ts';
import { AT_GAMES, BET, CBELL_N, COIN_PT, DAILY_GAME_LIMIT, GRAPH_EVERY, HIT, KOBOSHI_N, MACHINES, PAYOUT, REELS, ROLE_N, SPEC, TIMING, jstDay, jstWeekStart, oneIn } from '../lib/doki.ts';

export const prerender = false;

const env = (Astro.locals as { runtime?: { env?: Record<string, unknown> } }).runtime?.env;
const db = env?.DB as D1Database | undefined;
const origin = pokerOrigin(env);

const now = Date.now();
const week = jstWeekStart(now);
const today = jstDay(now);

// 台ごとのみんなの今日・今週（設定を推し量る材料。どれがどの設定かは週が終わるまで出さない）
interface MTot { machine: number; games: number; big: number; reg: number; cbell: number; players: number }
const MACHINE_NOS = [...MACHINES] as number[];
const emptyM = (): MTot[] => MACHINE_NOS.map((machine) => ({ machine, games: 0, big: 0, reg: 0, cbell: 0, players: 0 }));
let mToday = emptyM();
let mWeek = emptyM();
let pastWeeks: { week: string; settings: string }[] = [];
if (db) {
  try {
    // poker/src/doki.ts の MACHINE_TOTAL_SQL と同じ
    const q = (from: string) => db
      .prepare(`SELECT machine, SUM(games) AS games, SUM(big) AS big, SUM(reg) AS reg, SUM(cbell) AS cbell,
          COUNT(DISTINCT CASE WHEN games > 0 THEN discord_id END) AS players
        FROM doki_machine_daily WHERE day >= ? GROUP BY machine`)
      .bind(from).all<MTot>();
    const fill = (rows: MTot[] | undefined) => emptyM().map((e) => rows?.find((x) => x.machine === e.machine) ?? e);
    const [t, w, p] = await Promise.all([
      q(today), q(week),
      db.prepare('SELECT week, settings FROM doki_week WHERE week < ? ORDER BY week DESC LIMIT 8').bind(week).all<{ week: string; settings: string }>(),
    ]);
    mToday = fill(t.results);
    mWeek = fill(w.results);
    pastWeeks = p.results ?? [];
  } catch { /* 表がまだ無いときは 0 のまま出す */ }
}
interface Player extends NameStyleRow {
  discord_id: string; display_name: string; avatar_url: string | null;
  games: number; big: number; reg: number; pt: number; machines: string | null;
}
type PeriodKey = 'today' | 'week' | 'all';
const players: Record<PeriodKey, Player[]> = { today: [], week: [], all: [] };
if (db) {
  try {
    const q = (from: string) => db.prepare(
      `SELECT u.discord_id, u.display_name, u.avatar_url, ${NAME_STYLE_COLUMNS},
              SUM(d.games) AS games, SUM(d.big) AS big, SUM(d.reg) AS reg, SUM(d.coin_out - d.coin_in) AS pt,
              (SELECT GROUP_CONCAT(machine) FROM (SELECT DISTINCT machine FROM doki_machine_daily m
                 WHERE m.discord_id = d.discord_id AND m.day >= ? ORDER BY machine)) AS machines
       FROM doki_daily d
       JOIN users u ON u.discord_id = d.discord_id
       ${nameStyleJoin('u.discord_id')}
       WHERE d.day >= ?
       GROUP BY d.discord_id
       HAVING SUM(d.games) > 0
       ORDER BY pt DESC, games DESC
       LIMIT 50`,
    ).bind(from, from).all<Player>();
    const [t, w, a] = await Promise.all([q(today), q(week), q('0000-00-00')]);
    players.today = t.results ?? [];
    players.week = w.results ?? [];
    players.all = a.results ?? [];
  } catch { /* 表がまだ無いときは空で出す */ }
}
const PERIODS: [PeriodKey, string][] = [['today', '今日'], ['week', '今週'], ['all', 'これまで']];
const signed = (n: number) => (n > 0 ? '+' : '') + Math.round(n).toLocaleString('en-US');
const rate = (games: number, n: number, digits = 1) => (n > 0 ? `1/${(games / n).toFixed(digits)}` : '—');
const md = (d: string) => `${Number(d.slice(5, 7))}/${Number(d.slice(8, 10))}`;
const weekEnd = new Date(Date.parse(week + 'T00:00:00Z') + 6 * 86400_000).toISOString().slice(0, 10);
/** 終わった週の設定を、高い設定から「設定6 台3」の形で（設定4 まで） */
const highOf = (settings: string): [number, number[]][] => {
  const list = settings.split(',').map(Number);
  return [6, 5, 4].map((st): [number, number[]] => [st, list.flatMap((x, i) => (x === st ? [i + 1] : []))]).filter(([, ms]) => ms.length > 0);
};

const roles = [
  { sym: ['7', '7', '7'], name: 'BIG（AT 70G）', pay: '約210枚', pts: 210 * COIN_PT, odds: '設定別' },
  { sym: ['7', '7', 'B'], name: 'REG（AT 30G）', pay: '約90枚', pts: 90 * COIN_PT, odds: '設定別' },
  { sym: ['L', 'L', 'L'], name: '押し順ベル（ボーナス中のナビどおり・中段以外）', pay: `${PAYOUT.bell}枚`, pts: PAYOUT.bell * COIN_PT, odds: oneIn(ROLE_N.bells - CBELL_N[1]) },
  { sym: [] as string[], name: '押し順ベルの取りこぼし（通常時はいつも）', pay: `${PAYOUT.bell_miss}枚（1枚のことも）`, pts: 0, odds: '—' },
  { sym: ['L', 'L', 'L'], name: '共通ベル（中段）', pay: `${PAYOUT.cbell}枚`, pts: PAYOUT.cbell * COIN_PT, odds: '設定別' },
  { sym: ['S', 'S', 'S'], name: 'スイカ', pay: `${PAYOUT.suika}枚`, pts: PAYOUT.suika * COIN_PT, odds: oneIn(ROLE_N.suika) },
  { sym: ['C', '', ''], name: '角チェリー', pay: `${PAYOUT.cherry}枚`, pts: PAYOUT.cherry * COIN_PT, odds: oneIn(ROLE_N.cherry) },
  { sym: ['S', 'S', ''], name: '確定役（スイカのテンパイはずれ・BIG 確定）', pay: `${PAYOUT.kakutei}枚`, pts: PAYOUT.kakutei * COIN_PT, odds: oneIn(ROLE_N.kakutei) },
  { sym: ['C', '7', ''], name: '確定チェリー（中リール中段に 7・BIG 確定）', pay: `${PAYOUT.kcherry}枚`, pts: PAYOUT.kcherry * COIN_PT, odds: oneIn(ROLE_N.kcherry) },
  { sym: ['C', '', ''], name: '中段チェリー（BIG＋天国以上 確定）', pay: `${PAYOUT.mcherry}枚`, pts: PAYOUT.mcherry * COIN_PT, odds: oneIn(ROLE_N.mcherry) },
  { sym: ['R', 'R', 'R'], name: 'リプレイ', pay: '再遊技', pts: 0, odds: oneIn(ROLE_N.replay) },
];
/** 役の恩恵（通常時）：モードごとのボーナス当選率。設定1〜6 の幅で出す */
const pct = (a: readonly number[]) => (a[0] === a[5] ? `${a[0]}%` : `${a[0]}〜${a[5]}%`);
const BENEFITS: [string, keyof typeof HIT][] = [['通常A・B', 'N'], ['引き戻し', 'HK'], ['チャンス', 'CH'], ['保障・天国・ドキドキ・超ドキドキ', 'UP']];
const SYM_NAME: Record<string, string> = { '7': '7', B: 'BAR', L: 'ベル', R: 'リプレイ', C: 'チェリー', S: 'スイカ' };
const LAMPS: [string, string, string][] = [
  ['通常点滅', 'ボーナス確定', ''],
  ['高速点滅・スロー点滅', '通常B 以上のチャンス', ''],
  ['花と葉の交互点滅', '通常B 以上の期待', ''],
  ['337拍子', '天国の期待大', 't'],
  ['右のみ点滅・パネル消灯', '天国以上の期待大', 't'],
  ['左のみ点滅・リバースストリーム', 'ドキドキ以上確定', 'd'],
  ['ドキドキランプ点灯・しだれ柳', '超ドキドキ確定', 's'],
];
---
<Layout title="ぱびゅドキ！ | ぱぶびゅ！ダッシュボード">
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    {['7', 'B', 'L', 'C', 'S'].map((s) => (
      <symbol id={`dk-${s}`} viewBox="0 0 100 80" overflow="visible">
        <image href={`/doki/sym/${s}.webp`} x={s === 'B' ? -6 : 8} y={s === '7' ? 0 : 4} width={s === 'B' ? 112 : 84} height={s === '7' ? 80 : 72} preserveAspectRatio="xMidYMid meet" />
      </symbol>
    ))}
    <symbol id="dk-R" viewBox="0 0 100 80"><image href="/slot/sym/R.webp" x="8" y="5.3" width="84" height="69.4" preserveAspectRatio="xMidYMid meet" /></symbol>
  </svg>

  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mochiy+Pop+One&family=Righteous&display=swap" />
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14" id="doki-root" data-origin={origin}>
    <nav class="mb-6 flex flex-wrap items-center justify-between gap-2 text-sm">
      <a href="/" class="text-slate-400 hover:text-slate-200">← トップへ</a>
      <span class="dk-hall" role="group" aria-label="機種">
        <a href="/slot">🎰 ぱびゅらー</a><a href="/doki" aria-current="page">🌺 ぱびゅドキ！</a>
      </span>
    </nav>

    <header class="max-w-2xl">
      <h1 class="text-3xl font-black tracking-tight sm:text-4xl" style="text-wrap: balance">🌺 ぱびゅドキ！</h1>
      <p class="mt-2 text-sm leading-relaxed text-slate-400" style="text-wrap: pretty">
        沖ドキ風のスロットです。上の <b class="text-pink-300">ハイビスカス</b> が光ればボーナス。光り方で「次も 32G 以内に当たりそうか」が分かります。
        ボーナスは押し順ナビの AT（BIG 70G・REG 30G）。1枚 = {COIN_PT}pt、3枚掛け（{BET * COIN_PT}pt）。使えるポイントで遊べます。
      </p>
    </header>

    <section class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:items-start">
      <div class="mx-auto w-full max-w-[28rem]">
        <div class="dk-machines" role="group" aria-label="台を選ぶ">
          {MACHINE_NOS.map((m) => <button type="button" class="dk-machine" data-machine={m} aria-pressed={m === 1 ? 'true' : 'false'}>台{m}</button>)}
        </div>
        <div class="dk-cab" id="cab">
          <div class="dk-top">
            <div class="dk-sign"><b>ぱびゅドキ！</b><i>PUBYU-DOKI!</i></div>
            <div class="dk-hibi" id="hibi" aria-label="ハイビスカス" role="img">
              {[0, 1, 2, 3, 4].map(() => <img src="/doki/sym/H.webp" alt="" />)}
            </div>
            <div class="dk-subl"><span class="dk-dlamp" id="dlamp">DOKI DOKI</span></div>
          </div>
          <div class="dk-mid">
            <div class="dk-window">
              <div class="dk-reels" id="reels">
                {[0, 1, 2].map((r) => <div class="dk-reel" data-reel={r}><div class="dk-strip"></div></div>)}
              </div>
            </div>
            <div class="dk-kana" id="kana" aria-label="しなのちゃんランプ（BIG 中に光ると 1G連）" role="img"><img src="/doki/kana.webp" alt="" /></div>
          </div>
          <div class="dk-meter" aria-label="ボーナス後の回転数（32G まで）"><div class="dk-meter-bar" id="meter"></div><span id="meterText">—</span></div>
          <div class="dk-leds">
            <div class="dk-led"><span>CREDIT</span><b id="credit">----</b></div>
            <div class="dk-led"><span id="gameLabel">GAME</span><b id="gameCount">---</b></div>
            <div class="dk-led"><span>PAY</span><b id="pay">0</b></div>
          </div>
          <div class="dk-controls">
            <div class="grid gap-3">
              <div class="flex items-center justify-between gap-2">
                <button id="maxbet" type="button" class="dk-maxbet">MAX BET</button>
                <span id="credit-pt" class="text-[11px] text-slate-400 tabular-nums"></span>
              </div>
              <div class="dk-stops">
                {[0, 1, 2].map((r) => <button type="button" class="dk-stop" data-stop={r} disabled aria-label={`第${r + 1}リールを止める（${r + 1}キー）`}><span class="dk-nav"></span></button>)}
              </div>
            </div>
            <div class="dk-lever-box">
              <button id="lever" type="button" class="dk-lever" aria-label="レバー（スペース）"><span class="dk-lever-stick"></span><span class="dk-lever-knob"></span></button>
            </div>
          </div>
          <div class="dk-opts">
            <label><input id="auto" type="checkbox" /> 自動で止める（ナビどおり・当たりも揃えます）</label>
            <button id="sound" type="button" aria-pressed="true">🔊 音あり</button>
          </div>
          <p id="msg" class="dk-msg" aria-live="polite"></p>
          <p class="dk-keys">スペース：レバー・順に止める ／ 1 2 3 ／ Q W E：リールを止める ／ B：MAX BET</p>
        </div>
      </div>

      <div class="grid min-w-0 gap-6">
        <div class="dk-data">
          <div class="dk-data-head"><span>データカウンター</span><span class="text-slate-500">今日（{md(today)}）</span></div>
          <div class="dk-switches">
            <div class="dk-vm" role="group" aria-label="見る台">
              {MACHINE_NOS.map((m) => <button type="button" data-view-machine={m} aria-pressed={m === 1 ? 'true' : 'false'} aria-label={`台${m}`}>{m}</button>)}
            </div>
            <div class="dk-seg" role="group" aria-label="自分かみんなか">
              <button type="button" data-scope="mine" aria-pressed="true">自分</button>
              <button type="button" data-scope="all" aria-pressed="false">みんな</button>
            </div>
          </div>
          <div class="dk-counts">
            <div><span>BIG</span><b id="cBig" class="text-red-400">0</b></div>
            <div><span>REG</span><b id="cReg" class="text-sky-300">0</b></div>
            <div><span>総回転</span><b id="cGames">0</b></div>
            <div><span>現在</span><b id="cSince">0</b></div>
          </div>
          <div class="dk-rates">
            <div><span>ボーナス合算</span><b id="rSum">—</b></div>
            <div><span>共通ベル</span><b id="rBell">—</b></div>
            <div><span>差枚</span><b id="rDiff">0</b></div>
          </div>
          <div class="mt-4">
            <div class="flex items-baseline justify-between text-xs text-slate-400"><span>スランプグラフ（枚）</span><span>{GRAPH_EVERY}回転ごと</span></div>
            <div class="dk-graph-wrap"><svg id="graph" class="dk-graph" viewBox="0 0 400 200" role="img" aria-label="この台の今日の差枚の推移"></svg></div>
          </div>
          <div class="mt-4">
            <div class="text-xs text-slate-400">ボーナス履歴（今日・<span id="histLabel">自分</span>）<span class="text-pink-300">　🌺 は 32G 以内の連チャン</span></div>
            <ol id="history" class="dk-history"><li class="text-slate-500">まだありません</li></ol>
          </div>
          <div class="mt-4">
            <div class="text-xs text-slate-400">自分のこれまで（7日・全台の合計）</div>
            <div class="overflow-x-auto">
              <table class="dk-table mt-1"><thead><tr><th>日</th><th>回転</th><th>BIG</th><th>REG</th><th>差枚</th></tr></thead><tbody id="days"><tr><td colspan="5" class="text-slate-500">—</td></tr></tbody></table>
            </div>
          </div>
        </div>

        <div class="dk-data">
          <div class="dk-data-head"><span>みんなの台</span><span class="text-slate-500">{`設定6はどれ？（${md(week)}〜${md(weekEnd)}）`}</span></div>
          {[['today', '今日', mToday], ['week', '今週', mWeek]].map(([span, label, rows]) => (
            <div class="mt-2 overflow-x-auto">
              <table class="dk-table">
                <thead><tr><th>{label as string}</th><th>回転</th><th>BIG</th><th>REG</th><th>合算</th><th>共通ベル</th><th>人</th></tr></thead>
                <tbody>
                  {(rows as MTot[]).map((m) => (
                    <tr data-mrow={`${span}-${m.machine}`}>
                      <th>台{m.machine}</th>
                      <td data-k="games">{m.games.toLocaleString('en-US')}</td><td data-k="big">{m.big}</td><td data-k="reg">{m.reg}</td>
                      <td data-k="sum">{rate(m.games, m.big + m.reg)}</td><td data-k="cbell">{rate(m.games, m.cbell)}</td><td data-k="players">{m.players}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          <p class="mt-2 text-xs leading-relaxed text-slate-500">12台に設定 6・5・4・4・3・3・3・2・2・1・1・1 が1台ずつ入っています。どの台がどの設定かは毎週月曜に決まり直し、週が終わったら下に出します。合算と共通ベル（中段に揃うベル）で推し量りましょう。</p>
          {pastWeeks.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              {pastWeeks.map((w) => (
                <span class="rounded-full bg-slate-800/70 px-2.5 py-1 text-slate-300 ring-1 ring-slate-700">{md(w.week)}〜 {highOf(w.settings).map(([st, ms], i) => <b class={st === 6 ? 'text-amber-300' : 'text-slate-300'}>{i > 0 ? '／' : ''}設定{st} {ms.map((m) => `台${m}`).join('・')}</b>)}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="mt-12" id="players">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold">みんなの挑戦状況</h2>
          <p class="mt-1 text-xs text-slate-400">だれが、どれだけ回して、何枚勝っているか。差枚の多い順（50人まで）</p>
        </div>
        <div class="dk-seg" role="group" aria-label="期間">
          {PERIODS.map(([k, label]) => <button type="button" data-period={k} aria-pressed={k === 'today' ? 'true' : 'false'}>{label}</button>)}
        </div>
      </div>
      {PERIODS.map(([k]) => (
        <div class="mt-3 overflow-x-auto" data-period-panel={k} hidden={k !== 'today'}>
          {players[k].length === 0 ? (
            <p class="rounded-xl bg-slate-900/60 py-6 text-center text-sm text-slate-500 ring-1 ring-slate-800">まだだれも回していません</p>
          ) : (
            <table class="dk-table dk-players">
              <thead><tr><th>#</th><th class="text-left">名前</th><th>台</th><th>回転</th><th>BIG</th><th>REG</th><th>合算</th><th>差枚</th></tr></thead>
              <tbody>
                {players[k].map((p, i) => (
                  <tr>
                    <td class="text-slate-500">{i + 1}</td>
                    <td class="dk-player">
                      <img src={p.avatar_url ?? '/favicon.svg'} alt="" loading="lazy" class="h-6 w-6 shrink-0 rounded-full bg-slate-800 object-cover" />
                      <UserName name={p.display_name} style={p} href={userPath(p.display_name, p.discord_id)} class="truncate hover:underline" />
                    </td>
                    <td class="text-slate-400">{p.machines ? p.machines.split(',').map((m) => `台${m}`).join('・') : '—'}</td>
                    <td>{p.games.toLocaleString('en-US')}</td><td>{p.big}</td><td>{p.reg}</td>
                    <td>{rate(p.games, p.big + p.reg)}</td>
                    <td class={p.pt > 0 ? 'text-red-300 font-bold' : p.pt < 0 ? 'text-sky-300' : ''}>{signed(p.pt)}枚</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      ))}
    </section>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">
      <div class="min-w-0">
        <h2 class="text-lg font-bold">スペック表</h2>
        <div class="mt-3 overflow-x-auto">
          <table class="dk-table dk-spec">
            <thead><tr><th>設定</th><th>BIG</th><th>REG</th><th>合算</th><th>共通ベル</th><th>機械割</th></tr></thead>
            <tbody>
              {[1, 2, 3, 4, 5, 6].map((s) => (
                <tr><th>{s}</th><td>1/{SPEC[s].big}</td><td>1/{SPEC[s].reg}</td><td>1/{SPEC[s].sum}</td><td>{oneIn(CBELL_N[s])}</td><td class={SPEC[s].rate >= 100 ? 'text-amber-300' : ''}>{SPEC[s].rate.toFixed(1)}%</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <h3 class="mt-5 text-sm font-bold">役の恩恵（ボーナス当選率・設定1〜6）</h3>
        <div class="mt-2 overflow-x-auto">
          <table class="dk-table dk-spec">
            <thead><tr><th>モード</th><th>スイカ</th><th>チェリー</th><th>リプレイ・ベル</th></tr></thead>
            <tbody>
              {BENEFITS.map(([n, k]) => <tr><th>{n}</th><td>{pct(HIT[k].suika)}</td><td>{pct(HIT[k].cherry)}</td><td>{pct(HIT[k].other)}</td></tr>)}
            </tbody>
          </table>
        </div>
        <ul class="mt-2 grid gap-1 text-xs leading-relaxed text-slate-400">
          <li>・確定役・確定チェリー・中段チェリーは、どのモードでも BIG 確定です。中段チェリーは次が天国以上（天国中ならドキドキ、ドキドキ以上なら超ドキドキ）</li>
          <li>・チェリーで当たれば BIG、スイカは BIG と REG が半々、天井は BIG 60%。保障以上のリプレイ・ベルでの当たりは BIG 7：REG 3 です</li>
          <li>・次のモードも当たった役で変わります。スイカは通常B・天国に上がりやすく、確定役・確定チェリーは天国以上に上がりやすくなります。天国以上ではレア役で当たると上のモードに残ります</li>
        </ul>
