---
/**
 * ローカル版の外枠（本番のダッシュボードの Layout の簡易版。ナビ・ログイン・言語切り替えは無い）。
 * ローカルでは誰でも同じ1人として遊べるよう、ログインのトークンの代わりに "local" を入れておく。
 */
interface Props { title: string }
const { title } = Astro.props;
---
<html lang="ja" class="bg-slate-950 text-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>try { if (!localStorage.getItem('pv_poker_token')) localStorage.setItem('pv_poker_token', 'local'); } catch {}</script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
